{
    "name": "risqid/laravel-attendance-engine",
    "description": "Reusable Laravel attendance engine with stateless dynamic QR challenges.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.10|^11.0|^12.0",
        "illuminate/database": "^10.10|^11.0|^12.0",
        "illuminate/http": "^10.10|^11.0|^12.0",
        "illuminate/support": "^10.10|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.1|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Unwahas\\AttendanceEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unwahas\\AttendanceEngine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Unwahas\\AttendanceEngine\\AttendanceEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
